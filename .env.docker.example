# =============================================================================
# UPA do Tênis — Variáveis de Ambiente para Docker Local
#
# Copie este arquivo para .env.docker e preencha os valores.
#   cp .env.docker.example .env.docker
#
# NUNCA versione o arquivo .env.docker com valores reais.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=upa_user
POSTGRES_PASSWORD=TROCAR_PARA_SENHA_SEGURA
POSTGRES_DB=upa_do_tenis

# --- Aplicação ---
# A DATABASE_URL é montada automaticamente pelo docker-compose.local.yml.
# Não é necessário defini-la aqui.

# Chave de sessão — obrigatória.
# Gere com: openssl rand -hex 32
# Ou no PowerShell: -join ((1..32) | ForEach-Object { "{0:x2}" -f (Get-Random -Max 256) })
AUTH_SESSION_SECRET=TROCAR_PARA_CHAVE_GERADA
