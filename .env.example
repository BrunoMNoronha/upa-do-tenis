DATABASE_URL="postgresql://user:password@localhost:5432/upa_do_tenis?schema=public"

# Cache seletivo do servidor: ativar somente após homologação. Padrão desligado.
# Cache de serviços/formas operacionais e configuração; revalidação em 300s.
CACHE_DADOS_ENABLED="false"

# Chave usada para assinar o cookie de sessão (mínimo de 16 caracteres).
# Obrigatória em produção. Gere com: openssl rand -hex 32
AUTH_SESSION_SECRET=""

# reCAPTCHA v3 no login (opcional). Sem as duas chaves o captcha fica desligado.
# Ver docs/04-producao/RUNBOOK_RECAPTCHA_LOGIN.md
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Score mínimo em [0, 1]; padrão 0.5.
# RECAPTCHA_SCORE_MINIMO="0.5"

# Link público de acompanhamento da OS (opcional, mínimo de 16 caracteres).
# Sem ela, a chave é derivada de AUTH_SESSION_SECRET. Trocar este valor
# invalida TODOS os links de acompanhamento já enviados (revogação global).
# OS_ACOMPANHAMENTO_SECRET=""

# Criptografia da chave da Claude API salva em Configurações (opcional,
# mínimo de 16 caracteres). Sem ela, a chave é derivada de AUTH_SESSION_SECRET.
# Trocar este valor (ou o AUTH_SESSION_SECRET, se ela não estiver definida)
# exige cadastrar a chave da Claude API novamente.
# INSIGHTS_CRYPTO_SECRET=""

# WhatsApp comercial da landing pública (`/`), opcional. Telefone brasileiro
# com DDD (10 ou 11 dígitos), com ou sem máscara. Vazio ou inválido: a landing
# não mostra os botões "Agendar demonstração". Lido no servidor, não é
# NEXT_PUBLIC_*. Ver src/lib/landing-contato.ts
# LANDING_WHATSAPP="61985307168"

# Vercel Private Blob usado pelas fotos de recebimento dos itens da OS.
# Na Vercel, estas variáveis são injetadas ao conectar o store privado.
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""
# Apenas para desenvolvimento fora da Vercel, quando necessário. Em produção,
# prefira o OIDC gerenciado e não crie token estático.
# BLOB_READ_WRITE_TOKEN=""
