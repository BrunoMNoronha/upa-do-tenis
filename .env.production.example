# =============================================================================
# Variáveis de produção — ARQUIVO DE REFERÊNCIA, NUNCA COM VALORES REAIS.
#
# Repositório de verdade dos secrets:
#   - runtime da aplicação .......... Vercel (escopos Production e Preview)
#   - migrations (CI) ............... GitHub Environments (production / preview)
# Nada aqui deve ser preenchido e commitado.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE_URL — conexão POOLED, usada pelo runtime da aplicação.
#
# No Neon existem dois hostnames para a MESMA branch:
#   pooled  -> ep-xxxx-pooler.<regiao>.aws.neon.tech   (runtime)
#   direct  -> ep-xxxx.<regiao>.aws.neon.tech          (migrations/pg_dump)
#
# O parâmetro pgbouncer=true é obrigatório: desliga os prepared statements do
# Prisma, incompatíveis com o pooler em modo transaction. Sem ele aparecem
# erros de prepared statement em runtime.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<regiao>.aws.neon.tech/<database>?sslmode=require&pgbouncer=true&connect_timeout=15"

# -----------------------------------------------------------------------------
# DATABASE_URL_DIRECT — conexão DIRECT/UNPOOLED.
#
# Usada apenas por `prisma migrate deploy`, `prisma migrate status`,
# `bootstrap-admin` e `pg_dump`. O pooler quebra os advisory locks do Prisma
# Migrate, por isso a URL direct é obrigatória nesses comandos.
#
# NUNCA cadastrar esta variável na Vercel. Ela vive somente:
#   - como secret do GitHub Environment correspondente; e
#   - em arquivo local `.env.neon.*` (ignorado pelo git), durante a operação.
#
# O schema.prisma NÃO usa directUrl: o valor é injetado como DATABASE_URL
# apenas na invocação do comando.
# -----------------------------------------------------------------------------
DATABASE_URL_DIRECT="postgresql://<user>:<password>@<endpoint>.<regiao>.aws.neon.tech/<database>?sslmode=require"

# -----------------------------------------------------------------------------
# AUTH_SESSION_SECRET — assina o cookie de sessão (mínimo de 16 caracteres).
# Gere com: openssl rand -hex 32
#
# Production e Preview precisam de valores DIFERENTES. Preview também roda com
# NODE_ENV=production, então a ausência do segredo derruba a aplicação.
# -----------------------------------------------------------------------------
AUTH_SESSION_SECRET="<chave-aleatoria-com-32-bytes>"

# -----------------------------------------------------------------------------
# BOOTSTRAP_ADMIN_NOME / _EMAIL / _SENHA
#
# NÃO são secrets de runtime. Não cadastrar na Vercel nem no GitHub.
# Existem apenas dentro do arquivo local `.env.neon.prod` durante a janela do
# bootstrap inicial e devem ser removidos logo depois.
# Ver docs/04-producao/FATIA_PRODUCAO_04_VERCEL_NEON.md
# -----------------------------------------------------------------------------
