generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  estornosPagamento EstornoPagamento[]

  @@index([nome])
  @@index([ativo])
}

/// Contador de tentativas para rate limiting (issue #82).
///
/// Não é dado de domínio: cada registro é descartável depois de `expiraEm`,
/// nada referencia esta tabela e apagá-la por inteiro apenas zera bloqueios
/// em vigor. A chave é um hash — a tabela nunca guarda e-mail ou IP em claro.
model RegistroRateLimit {
  chave         String    @id
  falhas        Int       @default(0)
  bloqueadoAte  DateTime?
  ultimaFalhaEm DateTime
  expiraEm      DateTime
  atualizadoEm  DateTime  @updatedAt

  @@index([expiraEm])
}

model Cliente {
  id            String         @id @default(cuid())
  nome          String
  telefone      String
  email         String?
  cpfCnpj       String?
  observacoes   String?
  ativo         Boolean        @default(true)
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt
  ordensServico OrdemServico[]
  vendas        Venda[]

  @@index([nome])
  @@index([telefone])
  @@index([ativo])
}

model OrdemServico {
  id                              String                      @id @default(cuid())
  numero                          String                      @unique
  clienteId                       String
  cliente                         Cliente                     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  status                          String                      @default("ABERTA")
  dataEntrada                     DateTime
  dataPrevisao                    DateTime
  dataConclusao                   DateTime?
  valorTotal                      Decimal                     @default(0)
  valorDesconto                   Decimal                     @default(0)
  valorSinal                      Decimal                     @default(0)
  valorPago                       Decimal                     @default(0)
  saldo                           Decimal                     @default(0)
  justificativaInicioSemAprovacao String?
  observacoes                     String?
  favorita                        Boolean                     @default(false)
  criadoEm                        DateTime                    @default(now())
  atualizadoEm                    DateTime                    @updatedAt
  itens                           ItemOrdemServico[]
  pagamentos                      Pagamento[]
  historicosStatus                HistoricoStatus[]
  movimentacoesEstoque            MovimentacaoEstoqueInsumo[]
  movimentacoesCaixa              MovimentacaoCaixa[]

  @@index([numero])
  @@index([status])
  @@index([clienteId])
  @@index([favorita])
}

model ItemOrdemServico {
  id                      String                      @id @default(cuid())
  ordemServicoId          String
  ordemServico            OrdemServico                @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tipoItem                String
  descricao               String
  marca                   String?
  cor                     String?
  tamanho                 String?
  observacoes             String?
  fotoRecebimentoPathname String?
  valor                   Decimal                     @default(0)
  criadoEm                DateTime                    @default(now())
  atualizadoEm            DateTime                    @updatedAt
  servicos                ServicoItemOrdem[]
  insumos                 InsumoItemOrdem[]
  movimentacoesEstoque    MovimentacaoEstoqueInsumo[]
  fotos                   FotoItemOrdem[]

  @@index([ordemServicoId])
}

model FotoItemOrdem {
  id                 String           @id @default(cuid())
  itemOrdemServicoId String
  pathname           String           @unique
  criadoEm           DateTime         @default(now())
  itemOrdemServico   ItemOrdemServico @relation(fields: [itemOrdemServicoId], references: [id], onDelete: Cascade)

  @@index([itemOrdemServicoId, criadoEm])
}

model Servico {
  id           String             @id @default(cuid())
  nome         String
  descricao    String?
  precoBase    Decimal            @default(0)
  ativo        Boolean            @default(true)
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt
  itens        ServicoItemOrdem[]

  @@index([nome])
  @@index([ativo])
}

model ServicoItemOrdem {
  id                 String           @id @default(cuid())
  itemOrdemServicoId String
  servicoId          String
  itemOrdemServico   ItemOrdemServico @relation(fields: [itemOrdemServicoId], references: [id], onDelete: Cascade)
  servico            Servico          @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  descricao          String?
  valor              Decimal          @default(0)
  criadoEm           DateTime         @default(now())

  @@index([itemOrdemServicoId])
  @@index([servicoId])
}

model Produto {
  id                String                       @id @default(cuid())
  nome              String
  descricao         String?
  precoVenda        Decimal                      @default(0)
  quantidadeEstoque Decimal                      @default(0)
  ativo             Boolean                      @default(true)
  criadoEm          DateTime                     @default(now())
  atualizadoEm      DateTime                     @updatedAt
  itensVenda        ItemVenda[]
  movimentacoes     MovimentacaoEstoqueProduto[]

  @@index([nome])
  @@index([ativo])
}

model Venda {
  id                   String                       @id @default(cuid())
  numero               String                       @unique
  clienteId            String?
  cliente              Cliente?                     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  status               String                       @default("CONCLUIDA")
  valorTotal           Decimal                      @default(0)
  valorDesconto        Decimal                      @default(0)
  formaPagamentoId     String
  formaPagamento       FormaPagamento               @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  dataVenda            DateTime                     @default(now())
  observacoes          String?
  criadoEm             DateTime                     @default(now())
  atualizadoEm         DateTime                     @updatedAt
  itens                ItemVenda[]
  movimentacoesEstoque MovimentacaoEstoqueProduto[]
  movimentacoesCaixa   MovimentacaoCaixa[]

  @@index([numero])
  @@index([status])
  @@index([clienteId])
  @@index([dataVenda])
}

model ItemVenda {
  id            String   @id @default(cuid())
  vendaId       String
  venda         Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  descricao     String
  quantidade    Decimal  @default(0)
  precoUnitario Decimal  @default(0)
  precoTotal    Decimal  @default(0)
  criadoEm      DateTime @default(now())

  @@index([vendaId])
  @@index([produtoId])
}

model MovimentacaoEstoqueProduto {
  id             String   @id @default(cuid())
  produtoId      String
  produto        Produto  @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  tipo           String
  quantidade     Decimal  @default(0)
  saldoAnterior  Decimal  @default(0)
  saldoPosterior Decimal  @default(0)
  origem         String
  vendaId        String?
  venda          Venda?   @relation(fields: [vendaId], references: [id], onDelete: SetNull)
  itemVendaId    String?
  observacao     String?
  motivo         String?
  criadoEm       DateTime @default(now())

  @@index([produtoId])
  @@index([tipo])
  @@index([origem])
  @@index([criadoEm])
  @@index([vendaId])
}

model FormaPagamento {
  id                 String              @id @default(cuid())
  nome               String
  tipo               String?
  ativo              Boolean             @default(true)
  criadoEm           DateTime            @default(now())
  atualizadoEm       DateTime            @updatedAt
  pagamentos         Pagamento[]
  movimentacoesCaixa MovimentacaoCaixa[]
  vendas             Venda[]

  @@index([nome])
  @@index([ativo])
}

model Pagamento {
  id                String             @id @default(cuid())
  ordemServicoId    String
  ordemServico      OrdemServico       @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tipo              String
  valor             Decimal            @default(0)
  formaPagamentoId  String
  formaPagamento    FormaPagamento     @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  dataPagamento     DateTime
  observacoes       String?
  criadoEm          DateTime           @default(now())
  movimentacaoCaixa MovimentacaoCaixa?
  estorno           EstornoPagamento?

  @@index([ordemServicoId])
  @@index([formaPagamentoId])
  @@index([tipo])
}

// Estorno de um pagamento de OS (#230). Um pagamento tem no máximo um estorno,
// sempre do valor inteiro. O dia que conta no dashboard e nos relatórios é
// dataEstorno; a saída correspondente no caixa aponta para este registro.
model EstornoPagamento {
  id                String             @id @default(cuid())
  pagamentoId       String             @unique
  pagamento         Pagamento          @relation(fields: [pagamentoId], references: [id], onDelete: Restrict)
  valor             Decimal
  motivo            String
  usuarioId         String
  usuario           Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  dataEstorno       DateTime           @default(now())
  criadoEm          DateTime           @default(now())
  movimentacaoCaixa MovimentacaoCaixa?

  @@index([dataEstorno])
  @@index([usuarioId])
}

model HistoricoStatus {
  id             String       @id @default(cuid())
  ordemServicoId String
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  statusAnterior String?
  statusNovo     String
  observacao     String?
  criadoEm       DateTime     @default(now())

  @@index([ordemServicoId])
  @@index([statusNovo])
}

model Insumo {
  id                String                      @id @default(cuid())
  nome              String
  descricao         String?
  unidadeMedida     String
  quantidadeEstoque Decimal                     @default(0)
  estoqueMinimo     Decimal                     @default(0)
  custoUnitario     Decimal                     @default(0)
  ativo             Boolean                     @default(true)
  criadoEm          DateTime                    @default(now())
  atualizadoEm      DateTime                    @updatedAt
  itensOrdem        InsumoItemOrdem[]
  movimentacoes     MovimentacaoEstoqueInsumo[]

  @@index([nome])
  @@index([ativo])
}

model InsumoItemOrdem {
  id                    String           @id @default(cuid())
  itemOrdemServicoId    String
  insumoId              String
  quantidade            Decimal          @default(0)
  custoUnitarioAplicado Decimal          @default(0)
  custoTotalAplicado    Decimal          @default(0)
  observacoes           String?
  criadoEm              DateTime         @default(now())
  atualizadoEm          DateTime         @updatedAt
  itemOrdemServico      ItemOrdemServico @relation(fields: [itemOrdemServicoId], references: [id], onDelete: Cascade)
  insumo                Insumo           @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@index([itemOrdemServicoId])
  @@index([insumoId])
}

model MovimentacaoEstoqueInsumo {
  id                 String            @id @default(cuid())
  insumoId           String
  insumo             Insumo            @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  tipo               String
  quantidade         Decimal           @default(0)
  custoUnitario      Decimal           @default(0)
  custoTotal         Decimal           @default(0)
  saldoAnterior      Decimal           @default(0)
  saldoPosterior     Decimal           @default(0)
  origem             String
  ordemServicoId     String?
  ordemServico       OrdemServico?     @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)
  itemOrdemServicoId String?
  itemOrdemServico   ItemOrdemServico? @relation(fields: [itemOrdemServicoId], references: [id], onDelete: SetNull)
  observacao         String?
  motivo             String?
  criadoEm           DateTime          @default(now())

  @@index([insumoId])
  @@index([tipo])
  @@index([origem])
  @@index([criadoEm])
  @@index([ordemServicoId])
}

model Caixa {
  id                  String    @id @default(cuid())
  dataAbertura        DateTime  @default(now())
  dataFechamento      DateTime?
  saldoInicial        Decimal   @default(0)
  saldoFinalInformado Decimal?
  saldoFinalCalculado Decimal?
  divergencia         Decimal?
  status              String    @default("ABERTO") // ABERTO, FECHADO
  observacao          String?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  movimentacoes MovimentacaoCaixa[]

  @@index([status])
  @@index([dataAbertura])
}

model MovimentacaoCaixa {
  id               String          @id @default(cuid())
  caixaId          String
  caixa            Caixa           @relation(fields: [caixaId], references: [id], onDelete: Restrict)
  tipo             String // ENTRADA, SAIDA, SANGRIA, REFORCO
  origem           String // MANUAL, PAGAMENTO_OS, ESTORNO_PAGAMENTO_OS
  valor            Decimal
  descricao        String
  formaPagamentoId String?
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)

  pagamentoId        String?           @unique
  pagamento          Pagamento?        @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)
  estornoPagamentoId String?           @unique
  estornoPagamento   EstornoPagamento? @relation(fields: [estornoPagamentoId], references: [id], onDelete: SetNull)
  ordemServicoId     String?
  ordemServico       OrdemServico?     @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)
  vendaId            String?
  venda              Venda?            @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now())

  @@index([caixaId])
  @@index([tipo])
  @@index([origem])
  @@index([pagamentoId])
  @@index([ordemServicoId])
  @@index([vendaId])
}

model ConfiguracaoSistema {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt
}
